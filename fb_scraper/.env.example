# ==============================================================================
#  Facebook → Supabase Scraper – Environment Variables
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit `.env` to version control.
# ==============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # use service_role key, NOT anon key

# ── Facebook Page Target ──────────────────────────────────────────────────────
# Either a username (e.g. "CocaCola") or a full URL
FB_PAGE_URL=https://www.facebook.com/CocaCola

# ── Scraper behaviour ─────────────────────────────────────────────────────────
# How many posts to scrape per run (0 = unlimited / scrape all visible)
MAX_POSTS=20

# Seconds to wait between scrolls to mimic human behaviour
SCROLL_PAUSE_SECONDS=3

# Whether to archive media to Supabase Storage (true / false)
ARCHIVE_MEDIA=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/scraper.log
